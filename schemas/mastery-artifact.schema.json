{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/frankxai/awesome-gamification-agent-skills/schemas/mastery-artifact.schema.json",
  "title": "Mastery Artifact",
  "type": "object",
  "required": ["id", "type", "status", "visibility", "version"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "type": {
      "type": "string",
      "enum": ["skill", "node", "track", "trial", "loadout", "agent", "reward", "engine-adapter"]
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated"]
    },
    "visibility": {
      "type": "string",
      "enum": ["public", "unlisted", "private"]
    },
    "owner": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  },
  "additionalProperties": true
}

